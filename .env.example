DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SECRET_KEY=change-me-in-production
MCD_SIMULATE=0
MCD_ZIGBEE_PORT=/dev/ttyUSB0
MCD_MESHTASTIC_PORT=/dev/ttyACM0

# Optional: scripted remote vehicles V2 / V3 (extra Meshtastic boards). Leave empty to simulate them.
SIM_V2_PORT=
SIM_V2_HOST=
SIM_V3_PORT=
SIM_V3_HOST=
# Set to 0 to stop the web app from starting the sensor/alert runtime thread.
NODE_AUTOSTART=1
